{
  "name": "koa-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev -r tsconfig-paths/register server.ts",
    "dev:local": "dotenv -e .env.local -- ts-node-dev -r tsconfig-paths/register server.ts",
    "infra:local": "docker compose -f docker-compose.local.yml up -d --remove-orphans --wait",
    "infra:local:down": "docker compose -f docker-compose.local.yml down",
    "seed:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/seedLocal.ts",
    "assign-interview:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/assignLocalInterview.ts",
    "generate:yy25-videos:local": "ts-node -r tsconfig-paths/register scripts/generateYY25InterviewVideos.ts",
    "seed:yy25-interview:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/seedYY25Interview.ts",
    "setup:yy25-interview:local": "npm run generate:yy25-videos:local && npm run seed:yy25-interview:local",
    "inspect:t3-backup:local": "ts-node -r tsconfig-paths/register scripts/inspectT3Backup.ts",
    "migrate:t3-backup:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/migrateT3Backup.ts",
    "seed:t3-access:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/seedT3LocalAccess.ts",
    "verify:t3-backup:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/verifyT3Backup.ts",
    "restore:t3-backup:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/restoreT3Backup.ts",
    "rollback:t3-backup:local": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register scripts/rollbackT3Backup.ts",
    "setup:local": "npm run infra:local && npm run seed:local",
    "start": "node dist/dist.js",
    "build": "concurrently \"npm run prebuild\" \"webpack build --config ./webpack.prod.js\"",
    "prebuild": "node scripts/generateBuild",
    "prepare": "husky",
    "checkTypes": "tsc -p tsconfig.json --noEmit"
  },
  "types": "lib/",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@koa/bodyparser": "^5.0.0",
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^3.0.2",
    "aws-sdk": "^2.1529.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bluebird": "^3.7.2",
    "dotenv": "^16.3.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jsrsasign": "^11.1.0",
    "koa": "^2.14.2",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^7.0.2",
    "koa-i18n": "^2.1.0",
    "koa-locale": "^1.3.0",
    "koa-morgan": "^1.0.1",
    "koa-ratelimit": "^5.1.0",
    "koa-router": "^12.0.1",
    "mailparser": "^3.7.1",
    "moment": "^2.30.1",
    "mongoose": "^8.0.2",
    "multer": "^1.4.4",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "node-vibrant": "^3.2.1-alpha.1",
    "nodemailer": "^6.9.8",
    "openai": "^4.77.0",
    "openai-gpt-token-counter": "^1.1.1",
    "path-to-regexp": "^6.2.1",
    "pdf-parse": "^1.1.1",
    "pug": "^3.0.2",
    "qrcode": "^1.5.4",
    "redis": "^4.6.12",
    "redis-leader": "^0.1.0",
    "slugify": "^1.6.6",
    "stream-to-buffer": "^0.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "uuidv4": "^6.2.13",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@swc/core": "^1.4.0",
    "@types/axios": "^0.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bluebird": "^3.5.42",
    "@types/glob": "^8.1.0",
    "@types/helmet": "^4.0.0",
    "@types/koa": "^2.13.12",
    "@types/koa__cors": "^4.0.3",
    "@types/koa__multer": "^2.0.7",
    "@types/koa__router": "^12.0.4",
    "@types/koa-helmet": "^6.0.8",
    "@types/koa-morgan": "^1.0.8",
    "@types/koa-ratelimit": "^5.0.5",
    "@types/koa-router": "^7.4.8",
    "@types/mongoose": "^5.11.97",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "babel-loader": "^9.1.3",
    "babel-plugin-syntax-dynamic-import": "^6.18.0",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "msedge-tts": "^2.1.1",
    "nodemon": "^3.0.2",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.10.0",
    "webpack-node-externals": "^3.0.0"
  }
}
