# Safe local batch evaluation configuration.
MONGO_URI=mongodb://host.docker.internal:27018/heplin-local
MONGO_DB_NAME=heplin-local
SQS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_NAME=VideoJobQueueLocal
SQS_DLQ_NAME=VideoJobQueueLocalDLQ
COMPARISON_SQS_QUEUE_NAME=VideoComparisonQueueLocal
COMPARISON_SQS_DLQ_NAME=VideoComparisonQueueLocalDLQ
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
VIDEO_SOURCE=local
LOCAL_VIDEO_DIR=/videos-source
WORK_DIR=/app/videos
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=5m
MAX_PREFETCH=1
MAX_JOBS=1
MAX_VIDEOS_TO_PROCESS=1
AUDIO_THRESHOLD_DB=-60
