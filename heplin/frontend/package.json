{
  "name": "@devias-kit-pro/vite-starter",
  "version": "6.4.2",
  "author": "Devias",
  "homepage": "https://devias.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:company": "cross-env VITE_PROJECT_TYPE=company_app vite",
    "dev:admin": "cross-env VITE_PROJECT_TYPE=admin_app vite",
    "dev:accounts": "cross-env VITE_PROJECT_TYPE=accounts_app vite",
    "dev:company:local": "cross-env VITE_PROJECT_TYPE=company_app vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:accounts:local": "cross-env VITE_PROJECT_TYPE=accounts_app vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:admin:local": "cross-env VITE_PROJECT_TYPE=admin_app vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:all": "concurrently -k -n company,accounts,admin -c cyan,green,magenta \"npm:dev:company:local\" \"npm:dev:accounts:local\" \"npm:dev:admin:local\"",
    "build:company": "tsc && cross-env VITE_PROJECT_TYPE=company_app vite build",
    "build:admin": "tsc && cross-env VITE_PROJECT_TYPE=admin_app vite build",
    "build:accounts": "tsc && cross-env VITE_PROJECT_TYPE=accounts_app vite build",
    "deploy:accounts": "npm run build:accounts && wrangler pages deploy dist --project-name bursiyer",
    "deploy:company": "npm run build:company && wrangler pages deploy dist --project-name company",
    "start": "vite preview",
    "lint": "eslint ./src",
    "lint-fix": "eslint --fix ./src",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mdx}\" --cache"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@feathersjs/authentication-client": "^5.0.33",
    "@feathersjs/feathers": "^5.0.33",
    "@feathersjs/rest-client": "^5.0.33",
    "@fontsource/inter": "5.0.4",
    "@fontsource/plus-jakarta-sans": "5.0.4",
    "@fontsource/roboto-mono": "5.0.4",
    "@mui/icons-material": "5.13.7",
    "@mui/lab": "5.0.0-alpha.135",
    "@mui/material": "5.13.7",
    "@mui/system": "5.13.7",
    "@mui/x-data-grid": "^6.20.4",
    "@mui/x-date-pickers": "6.9.1",
    "@react-pdf-viewer/core": "^3.12.0",
    "@tanstack/react-query": "^4.36.1",
    "@untitled-ui/icons-react": "0.1.1",
    "@zoom/meetingsdk": "^3.10.0",
    "apexcharts": "^3.54.1",
    "axios": "^1.8.4",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "date-fns": "2.30.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "formik": "^2.4.6",
    "html-react-parser": "^4.2.10",
    "hugeicons-react": "^0.2.0",
    "i18next": "23.2.7",
    "iframe-resizer-react": "^1.1.1",
    "lodash.debounce": "^4.0.8",
    "lodash.isequal": "4.5.0",
    "lodash.update": "^4.10.2",
    "mui-one-time-password-input": "^2.0.3",
    "notistack": "^3.0.2",
    "nprogress": "0.2.0",
    "numeral": "2.0.6",
    "pdfjs-dist": "^5.4.296",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-apexcharts": "^1.4.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-countdown": "^2.3.6",
    "react-date-range": "^1.4.0",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.3.8",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "2.4.1",
    "react-i18next": "13.0.1",
    "react-player": "^2.16.0",
    "react-quill": "^2.0.0",
    "react-router": "6.14.1",
    "react-router-dom": "6.14.1",
    "react-slick": "0.29.0",
    "simplebar-react": "3.2.4",
    "slick-carousel": "1.8.1",
    "slugify": "^1.6.6",
    "store": "^2.0.12",
    "styled-components": "^6.1.16",
    "stylis": "4.3.0",
    "stylis-plugin-rtl": "2.1.1",
    "xss": "^1.0.15",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.isequal": "4.5.6",
    "@types/node": "20.4.0",
    "@types/nprogress": "0.2.0",
    "@types/numeral": "2.0.2",
    "@types/react": "18.2.14",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "18.2.6",
    "@types/react-slick": "0.23.10",
    "@types/store": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "5.61.0",
    "@typescript-eslint/parser": "5.61.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "8.44.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "postcss": "^8.5.3",
    "prettier": "3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.1.6",
    "vite": "^6.2.2"
  }
}
