# ======================================================================
# Merkezi LLM Platformu - ornek ortam degiskenleri
# Bu dosyayi .env olarak kopyalayin. GERCEK secret'lari .env icine yazin,
# .env dosyasi .gitignore ile repo disinda tutulur.
# ======================================================================

# --- Genel ---
APP_ENV=development
LOG_LEVEL=INFO
# Her istege atanan izleme kimligi bu header ile tasinir/okunur.
CORRELATION_ID_HEADER=X-Correlation-Id

# --- PostgreSQL (host makinede calisir, Docker container'i olusturulmaz) ---
# Docker icindeki servisler host Postgres'e host.docker.internal uzerinden baglanir:
DATABASE_URL=postgresql+psycopg_async://ai_platform_user:degistir-beni@host.docker.internal:5432/ai_platform
# Docker DISINDA (host'ta) calistirilacaksa localhost kullanin:
# DATABASE_URL=postgresql+psycopg_async://ai_platform_user:degistir-beni@localhost:5432/ai_platform
# Testler icin ayri veritabani (integration/e2e):
DATABASE_URL_TEST=postgresql+psycopg_async://ai_platform_user:degistir-beni@localhost:5432/ai_platform_test

# PostgreSQL baglanti havuzu (toplam instance sayisini da hesaba katin)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30

# --- API kimlik dogrulama ---
# API key secret kismi veritabaninda saklanmaz; HMAC-SHA256 ile dogrulanir.
# Guclu rastgele bir deger uretin (orn: openssl rand -hex 32).
API_KEY_HMAC_SECRET=degistir-beni-guclu-rastgele-deger
API_HOST=0.0.0.0
API_PORT=8080

# --- Model saglayici / Ollama ---
MODEL_PROVIDER=ollama
# Docker Compose ic agindaki ollama servisi:
OLLAMA_HOST=http://ollama:11434
# Host'ta calistirilirsa:
# OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b-it-q4_K_M
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONNECTIONS=10
# Baslangicta modeli bellege almak icin istege bagli warm-up.
OLLAMA_WARMUP=false

# --- Kafka (KRaft, tek broker) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_REQUESTED=ai.jobs.requested.v1
KAFKA_TOPIC_EVENTS=ai.jobs.events.v1
KAFKA_TOPIC_DLQ=ai.jobs.dlq.v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP=ai-worker
# Uzun inference sirasinda rebalance olmamasi icin yuksek tutulur.
KAFKA_MAX_POLL_INTERVAL_MS=600000
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_HEARTBEAT_INTERVAL_MS=15000

# --- Worker / inference ---
MAX_CONCURRENT_INFERENCE=1
WORKER_INTERNAL_QUEUE_SIZE=10
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
# Model ciktisi semaya uymazsa sinirli sayida duzeltme denemesi.
MODEL_OUTPUT_MAX_FIX_ATTEMPTS=1

# --- Istek / girdi limitleri (backpressure ve guvenlik) ---
MAX_REQUEST_BYTES=65536
MAX_MESSAGES=50
MAX_TOTAL_INPUT_CHARS=24000
MAX_INPUT_TOKENS=6000
MAX_OUTPUT_TOKENS=2048
MAX_RESULT_BYTES=131072
TEMPERATURE_MIN=0.0
TEMPERATURE_MAX=2.0
# Response schema sinirlari
MAX_RESPONSE_SCHEMA_BYTES=8192
MAX_RESPONSE_SCHEMA_DEPTH=6
MAX_RESPONSE_SCHEMA_PROPERTIES=64

# --- Backpressure / kapasite ---
PROJECT_MAX_ACTIVE_JOBS=50
PROJECT_MAX_PENDING_JOBS=200
GLOBAL_MAX_PENDING_JOBS=2000

# --- Outbox publisher ---
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_BACKOFF_BASE_SECONDS=1.0
OUTBOX_BACKOFF_MAX_SECONDS=60.0

# --- Retry dispatcher ---
RETRY_MAX_ATTEMPTS=3
# Deneme gecikmeleri (saniye): 1. retry 10s, 2. retry 60s, 3. retry 5dk
RETRY_BACKOFF_SECONDS=10,60,300
RETRY_DISPATCHER_POLL_INTERVAL_SECONDS=5.0

# --- Veri saklama (retention) ---
# Hassas payload/result bu sure sonunda temizlenir (0 = devre disi).
RETENTION_DAYS=30
RETENTION_POLL_INTERVAL_SECONDS=3600

# --- Metrikler ---
# API /metrics endpoint'inden sunar. Diger process'ler bu portta sunar.
METRICS_PORT=9100
